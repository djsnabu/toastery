---
import UnderlineHeading from './UnderlineHeading.astro';
import PostCard from './PostCard.astro';
import { journal } from '../content/copy.en';
import { getPublishedPosts } from '../utils/blog';

const posts = (await getPublishedPosts()).slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="latest section">
      <div class="container">
        <p class="label">{journal.label}</p>
        <UnderlineHeading as="h2">{journal.title}</UnderlineHeading>
        <p class="latest__intro">{journal.intro}</p>
        <div class="latest__grid">
          {posts.map((post, i) => (
            <PostCard post={post} featured={i === 0} showImage={false} />
          ))}
        </div>
        <p class="latest__more">
          <a class="link-arrow" href="/blog">
            {journal.readAll}
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .latest .heading-serif {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.25rem;
  }

  .latest__intro {
    max-width: 40ch;
    color: var(--toastery-grey);
    margin: var(--space-md) 0 var(--space-lg);
  }

  .latest__grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .latest__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .latest__more {
    margin-top: var(--space-lg);
  }
</style>
